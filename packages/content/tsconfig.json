{
  // Whole package, including the Node entry (src/node.ts), with Node types.
  // The Worker-safe pure entry is additionally checked without Node types by
  // tsconfig.pure.json; `pnpm typecheck` runs both.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
