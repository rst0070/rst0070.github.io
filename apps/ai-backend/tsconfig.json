{
  // The Worker (src/) with the runtime types and Env generated by
  // `wrangler types` into worker-configuration.d.ts, and no Node types. The
  // scripts run on Node and are checked by tsconfig.script.json; the pure core
  // is additionally checked by tsconfig.core.json. `pnpm typecheck` runs all.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
